APP_NAME=Shiclash
APP_ENV=production
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://YOUR-LARAVEL-HOST.example

LOG_CHANNEL=stack
LOG_LEVEL=warning

# Supabase Connect > Direct > Session pooler (IPv4 compatible).
DB_CONNECTION=pgsql
DB_HOST=aws-0-ap-northeast-1.pooler.supabase.com
DB_PORT=5432
DB_DATABASE=postgres
DB_USERNAME=postgres.afjymbdawczewdjganlt
DB_PASSWORD=SET_IN_HOST_SECRET_MANAGER
DB_SSLMODE=require
DB_SCHEMA=shiclash

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
MAIL_MAILER=log
VITE_APP_NAME="${APP_NAME}"
